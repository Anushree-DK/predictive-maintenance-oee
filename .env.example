# "mock" runs the whole pipeline against local CSVs in data/mock/ (no Snowflake account needed).
# "snowflake" reads/writes the real tables via Snowpark. Switch once you have a trial account.
SNOWFLAKE_MODE=mock

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PDM
SNOWFLAKE_SCHEMA=PUBLIC
