# "local" runs the whole pipeline against data/processed/*.csv, built from the real
# NASA C-MAPSS data by scripts/load_cmapss.py (no Snowflake account needed).
# "snowflake" reads/writes the same tables in Snowflake via Snowpark.
SNOWFLAKE_MODE=local

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=PDM
SNOWFLAKE_SCHEMA=PUBLIC
